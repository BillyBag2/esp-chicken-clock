# ESP32_MOS_X2_V1.1 uses a classic ESP32 (ESP32-32E N4).
CONFIG_IDF_TARGET="esp32"

# Match the board's current flash configuration.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Use nearly all of the 4 MB flash for the single application image. This
# leaves the standard NVS and PHY partitions before the application.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Keep a primary NTP service and two fallback services.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Keep flashing and monitor output aligned with the default UART console.
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
